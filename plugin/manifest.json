{
  "manifest_version": 3,
  "name": "AoC Submission Timer",
  "version": "1.0",
  "description": "Measures time since the last form submission on adventofcode.com.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://adventofcode.com/*"],
  "content_scripts": [
    {
      "matches": ["https://adventofcode.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
